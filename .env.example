# Single-database setup (used when LOG_TARGETS is not set):
MSSQL_SERVER=your-sql-server-host
MSSQL_PORT=1433
MSSQL_DATABASE=your-database-name
MSSQL_USER=your-sql-login
MSSQL_PASSWORD=your-sql-password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# Multi-database setup: set LOG_TARGETS to a JSON array and the query_logs
# tool gets a "target" parameter to pick which one to query. When set, the
# MSSQL_* variables above are ignored.
# LOG_TARGETS=[{"name":"prod","server":"prod-sql-host","database":"Logs","user":"login","password":"secret"},{"name":"staging","server":"staging-sql-host","database":"Logs","user":"login","password":"secret"}]
